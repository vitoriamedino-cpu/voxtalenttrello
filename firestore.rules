rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email is string;
    }
    function ownAccountPath() {
      return /databases/$(database)/documents/accessAccounts/$(request.auth.token.email.lower());
    }
    function isActiveAdmin() {
      return signedIn()
        && exists(ownAccountPath())
        && get(ownAccountPath()).data.email.lower() == request.auth.token.email.lower()
        && get(ownAccountPath()).data.status == 'Ativo'
        && get(ownAccountPath()).data.nivelAcesso == 'Admin';
    }
    match /accessAccounts/{email} {
      allow get: if signedIn() && (email == request.auth.token.email.lower() || isActiveAdmin());
      allow list: if isActiveAdmin();
      allow create, update, delete: if isActiveAdmin();
    }
  }
}
